# Copy to .env. Generate strong values; never commit .env to Git.
HERMAS_ADMIN_PASSWORD=CHANGE-ME-TO-A-LONG-UNIQUE-PASSWORD
HERMAS_SESSION_SECRET=CHANGE-ME-USE-python-secrets-token_hex-32-BEFORE-LAUNCH
# Demo: offline deterministic sample commands, NOT a real AI model.
HERMAS_MODEL_PROVIDER=demo
# To enable real OpenAI-compatible chat completions:
# HERMAS_MODEL_PROVIDER=openai
# HERMAS_MODEL_API_KEY=sk-your-key
# HERMAS_MODEL_BASE_URL=https://api.openai.com/v1
HERMAS_MODEL=gpt-4.1-mini
HERMAS_WORKSPACE=./workspace
HERMAS_DATA_DIR=./data
HERMAS_ALLOWED_HOSTS=localhost,127.0.0.1
HERMAS_SECURE_COOKIE=false
HERMAS_ENABLE_DOCKER_TESTS=false
HERMAS_MAX_STEPS=6
HERMAS_MAX_OUTPUT_TOKENS=1200
HERMAS_DAILY_TOKEN_BUDGET=40000

# v0.2 uses a durable SQLite task queue. Single worker and single process only.
# Task retries are manual (maximum 3 for failures); worker starts automatically.

# v0.3: verified memory, Git Coding Studio, multi-agent Review via task kind.
# Git operations are limited to a disposable ordinary Git checkout whose root
# is exactly HERMAS_WORKSPACE. No Git network operations are supported.
# Multi-Agent Review requires a configured real model for genuine analysis.

# v0.4 - Automation & Integration
# All schedules use five-field UTC cron expressions. New schedules are DISABLED.
# Workflow definitions are stored in SQLite and never auto-approve file edits.
# Plugin/MCP registry stores manifests only; external tool execution is not available.

# Telegram polling is disabled by default. Use private bot token and numeric chat ID allowlist.
HERMAS_TELEGRAM_ENABLED=false
# HERMAS_TELEGRAM_TOKEN=123456789:replace_me
HERMAS_TELEGRAM_CHAT_IDS=
HERMAS_TELEGRAM_ALLOW_RUN=false

# Read-only browser preview is disabled by default. Optional dependencies:
# pip install playwright && playwright install chromium
# This is NOT a network sandbox. Use a dedicated isolated container for untrusted sites.
HERMAS_BROWSER_ENABLED=false
HERMAS_BROWSER_HOSTS=

# v0.5 VPS Commander: inventory + offline backup/deploy plans work without SSH.
# To opt into READ-ONLY remote checks, set true and provide operator-pinned keys.
# Never expose keys in chat, dashboard, database or the ZIP distribution.
HERMAS_VPS_SSH_ENABLED=false
HERMAS_VPS_SSH_KEY_PATH=
HERMAS_VPS_KNOWN_HOSTS_PATH=
# Host keys must be verified out of band; ssh-keyscan alone is not authentication.
# Use a non-root account; grant the least privileges needed for read-only scans.
# Remote backup/deployment execution is NOT implemented in v0.5.

# v0.6 Intelligent Operations (ALL disabled by default)
# Monitoring needs SSH read-only enabled, verified SSH key/known_hosts and enabled hosts.
# Monitors are created disabled and must be individually enabled in the dashboard.
HERMAS_VPS_MONITOR_ENABLED=false
# Allow sending sanitized alert status to allowlisted Telegram chat IDs.
# Requires HERMAS_TELEGRAM_TOKEN and HERMAS_TELEGRAM_CHAT_IDS even if Telegram polling is disabled.
HERMAS_ALERT_TELEGRAM_ENABLED=false
# Local workspace source snapshots are stored in HERMAS_DATA_DIR/snapshots.
# These are NOT remote VPS snapshots or database backups.
